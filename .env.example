# Server only. Create a token at https://www.runcomfy.com and paste it here for local dev.
RUNCOMFY_TOKEN=

# Optional. Paste a full affiliate URL to replace the default store link.
PUBLIC_PS_STORE_URL=
PUBLIC_XBOX_STORE_URL=
PUBLIC_ROCKSTAR_URL=

# Optional. When set, pages reserve a labeled ad slot of this height in pixels (for example 280).
PUBLIC_AD_HEIGHT=
