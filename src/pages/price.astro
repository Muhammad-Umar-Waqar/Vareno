---
import Base from '../layouts/Base.astro';
import Byline from '../components/Byline.astro';
import FaqList from '../components/FaqList.astro';
import Retailers from '../components/Retailers.astro';
import Sources from '../components/Sources.astro';
import AdSlot from '../components/AdSlot.astro';
import Keywords from '../components/Keywords.astro';
import InnerPageLayout from '../components/InnerPageLayout.astro';
import CtaDashedGrid from '../components/CtaDashedGrid.astro';
import GlowingCard from '../components/GlowingCard.astro';
import { sources } from '../data/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../lib/seo';

const title = 'How Much Is GTA 6? Price and Pre-Order | Vareno';
const description =
  'GTA 6 is $79.99 for Standard and $99.99 for Ultimate on PS5 and Xbox Series X|S. See what pre-order adds, and why there is no separate collector edition.';
const path = '/price';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Price', path },
];

const faqs = [
  {
    q: 'How much is GTA 6?',
    a: 'GTA 6 is $79.99 for the Standard Edition and $99.99 for the Ultimate Edition. Take-Two published those US prices on June 24, 2026 for PlayStation 5 and Xbox Series X|S. Prices in other countries can differ.',
  },
  {
    q: 'How much will GTA 6 cost?',
    a: "The announced US prices are $79.99 and $99.99. Standard is the game. Ultimate adds premium vehicles, weapons, apparel, and actions across Jason and Lucia's story. Take-Two's June 24, 2026 release is the source for both figures.",
  },
  {
    q: 'How much is the GTA 6 pre-order?',
    a: 'A pre-order uses the same $79.99 or $99.99 price as the edition you pick. Purchases before November 20, 2026 include the Vintage Vice City Pack. Digital pre-orders also include one month of GTA+, which Take-Two says can be redeemed with the existing GTA Online library.',
  },
  {
    q: "Is there a GTA 6 collector's edition?",
    a: "Take-Two's pre-order announcement does not name a collector's edition. The premium product in that release is the Ultimate Edition at $99.99. If Rockstar later ships a box with a different name, this page should be updated from that announcement.",
  },
];

const editionHighlights = [
  {
    icon: 'disc',
    badge: 'Standard Edition',
    title: '$79.99 Base Game',
    desc: 'The complete GTA VI campaign spanning Vice City and Leonida. Free pre-order pack included before Nov 20.',
    stat: '$79.99',
    statLabel: 'MSRP',
    glowColor: '#39d0ff',
  },
  {
    icon: 'crown',
    badge: 'Ultimate Edition',
    title: '$99.99 Deluxe Tier',
    desc: 'Adds exclusive customized vehicles, weapons, and special story actions threaded through Jason and Lucia’s campaign.',
    stat: '$99.99',
    statLabel: 'MSRP',
    glowColor: '#f7c948',
  },
  {
    icon: 'gift',
    badge: 'Pre-Order Bonus',
    title: 'Vintage Vice City Pack',
    desc: 'Retro vehicle styles, classic apparel, and one free month of GTA+ membership included with digital reservations.',
    stat: 'Bonus Pack',
    statLabel: 'Before Nov 20',
    glowColor: '#ff5c8a',
  },
];
---

<Base
  title={title}
  description={description}
  ogType="article"
  schemas={[
    articleSchema({ headline: 'How much is GTA 6?', description, path }),
    breadcrumbSchema(crumbs),
    faqSchema(faqs),
  ]}
>
  <InnerPageLayout pageTitle="GTA 6 Price &amp; Editions" crumbs={crumbs} heroImg="/images/gta6-lockload.webp" accentColor="#f7c948">

    <!-- ══════════════════════════════════════════════════════════
         TOP 2-COLUMN HEADER OVERVIEW
         ══════════════════════════════════════════════════════════ -->
    <section class="price-hero-split" data-reveal>
      <div class="price-hero-meta">
        <span class="price-badge">Official Take-Two Pricing</span>
        <h2 class="price-main-heading">Two Editions, Firm Pricing</h2>
        <p class="price-lead">{faqs[0].a}</p>
        <Byline />
      </div>

      <div class="price-hero-card">
        <div class="ph-card-inner">
          <span class="ph-pill">OFFICIAL STORE PRICING</span>
          <div class="ph-prices">
            <div class="ph-price-item">
              <span class="ph-label">Standard</span>
              <strong class="ph-val">$79.99</strong>
            </div>
            <div class="ph-divider"></div>
            <div class="ph-price-item">
              <span class="ph-label ph-gold">Ultimate</span>
              <strong class="ph-val ph-gold">$99.99</strong>
            </div>
          </div>
          <p class="ph-note">Prices confirmed in Take-Two's June 24, 2026 pre-order filing for PS5 and Xbox Series X|S.</p>
        </div>
      </div>
    </section>

    <AdSlot />

    <!-- ══════════════════════════════════════════════════════════
         EDITION CARDS 3D GRID
         ══════════════════════════════════════════════════════════ -->
    <section class="price-cards-section" data-reveal>
      <h2 class="price-section-title">Standard &amp; Ultimate Editions</h2>
      <div class="edition-cards">

        <div class="edition-card edition-card--standard">
          <div class="edition-card-badge">Standard Tier</div>
          <div class="edition-card-price">$79.99</div>
          <div class="edition-card-tag">Base Campaign Game</div>
          <ul class="edition-card-list">
            <li>✅ Grand Theft Auto VI Full Game</li>
            <li>✅ PS5 &amp; Xbox Series X|S Native</li>
            <li>✅ Vintage Vice City Pack (Pre-order before Nov 20)</li>
            <li>✅ 1 month GTA+ Membership (Digital pre-order)</li>
            <li>❌ Premium story vehicles &amp; outfits</li>
          </ul>
          <a
            class="edition-card-cta"
            href="https://store.playstation.com/en-us/product/EP1004-PPSA01547_00-GTAVISTANDARD001/"
            target="_blank"
            rel="sponsored noopener noreferrer"
          >Pre-order Standard ↗</a>
        </div>

        <div class="edition-card edition-card--ultimate">
          <div class="edition-card-badge edition-card-badge--gold">Ultimate Tier</div>
          <div class="edition-card-price edition-card-price--gold">$99.99</div>
          <div class="edition-card-tag">Expanded Narrative Content</div>
          <ul class="edition-card-list">
            <li>✅ Grand Theft Auto VI Full Game</li>
            <li>✅ PS5 &amp; Xbox Series X|S Native</li>
            <li>✅ Vintage Vice City Pack (Pre-order before Nov 20)</li>
            <li>✅ 1 month GTA+ Membership (Digital pre-order)</li>
            <li>✅ Premium vehicles, weapons &amp; apparel</li>
            <li>✅ Exclusive story actions for Jason &amp; Lucia</li>
          </ul>
          <a
            class="edition-card-cta edition-card-cta--gold"
            href="https://store.playstation.com/en-us/product/EP1004-PPSA01547_00-GTAVISTANDARD001/"
            target="_blank"
            rel="sponsored noopener noreferrer"
          >Pre-order Ultimate ↗</a>
        </div>

      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         TWO-COLUMN COMPARISON & TABLE
         ══════════════════════════════════════════════════════════ -->
    <section class="two-col-compare" data-reveal>
      <div class="compare-table-col">
        <h2 class="price-section-title">Edition Feature Breakdown</h2>
        <div class="price-table-hint" aria-hidden="true">
          <span>⇄ Swipe horizontally to compare features</span>
        </div>
        <div class="price-table-wrap">
          <table>
            <caption class="visually-hidden">GTA 6 Standard and Ultimate editions comparison</caption>
            <thead>
              <tr>
                <th scope="col">Included Feature</th>
                <th scope="col">Standard<br/><span class="th-price">$79.99</span></th>
                <th scope="col">Ultimate<br/><span class="th-price th-price--gold">$99.99</span></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Full GTA VI Campaign</th>
                <td><span class="check">✅</span></td>
                <td><span class="check">✅</span></td>
              </tr>
              <tr>
                <th scope="row">Exclusive Story Vehicles &amp; Weapons</th>
                <td><span class="cross">❌</span></td>
                <td><span class="check">✅</span></td>
              </tr>
              <tr>
                <th scope="row">Vintage Vice City Pack (Pre-orders)</th>
                <td><span class="check">✅</span></td>
                <td><span class="check">✅</span></td>
              </tr>
              <tr>
                <th scope="row">1 Month of GTA+ Subscription</th>
                <td><span class="check">✅</span></td>
                <td><span class="check">✅</span></td>
              </tr>
              <tr>
                <th scope="row">Character Story Actions</th>
                <td><span class="cross">❌</span></td>
                <td><span class="check">✅</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- RIGHT VISUAL CARD: Ultimate Edition Spotlight -->
      <div class="compare-visual-col">
        <div class="ultimate-spotlight-card">
          <div class="usc-img-wrap">
            <img src="/images/gta6-hero.webp" alt="GTA VI Ultimate Edition Content" loading="lazy" />
            <span class="usc-tag">Take-Two SEC Filing</span>
          </div>
          <div class="usc-body">
            <h3 class="usc-title">Why No Separate Collector's Box?</h3>
            <p class="usc-desc">
              Take-Two's official announcement explicitly listed Ultimate Edition as its flagship premium offering.
              Physical retail copies contain download redemption codes inside collectible packaging, but no separate $150+
              statue edition was announced.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         TWO-COLUMN: WHAT A PRE-ORDER ADDS + CTA DASHED GRID
         ══════════════════════════════════════════════════════════ -->
    <section class="two-col-preorder-perks" data-reveal>
      <div class="perks-dashed-col">
        <CtaDashedGrid
          badge="Pre-Order Window"
          title="What Pre-Ordering"
          highlight="Actually Unlocks"
          leadText="Every player who orders before November 20, 2026 receives bonus content regardless of platform."
          ctaText="View Launch Date"
          ctaHref="/release-date"
        >
          <p>
            Digital pre-orders unlock one free month of GTA+ (granting instant access to the existing GTA Online library and Grand Theft Auto V).
            Orders before November 20 lock in the Vintage Vice City Pack with vintage rides and retro Miami threads.
          </p>
        </CtaDashedGrid>
      </div>

      <div class="perks-timeline-col">
        <h3 class="perks-title">Pre-Order Milestones</h3>
        <ol class="price-timeline">
          <li>
            <time datetime="2026-06-25">June 25, 2026</time>
            <span>Pre-orders opened globally on digital console stores at midnight.</span>
          </li>
          <li>
            <time datetime="2026-11-10">November 10, 2026</time>
            <span>Rockstar opened digital pre-load for all confirmed pre-order holders.</span>
          </li>
          <li>
            <time datetime="2026-11-19">November 19, 2026</time>
            <span>Launch Day! The game unlocks at 5:00 a.m. UTC on PS5 and Xbox Series X|S.</span>
          </li>
          <li>
            <time datetime="2026-11-20">November 20, 2026</time>
            <span>Vintage Vice City bonus pack purchase cutoff deadline.</span>
          </li>
        </ol>
      </div>
    </section>

    <!-- Glowing Edition Highlights -->
    <GlowingCard
      title="Pricing &amp; Value Breakdown"
      subtitle="Interact with each card to explore edition perks and retail confirmation details."
      items={editionHighlights}
    />

    <!-- Retailers Component -->
    <Retailers />

    <!-- Aceternity Simple FAQs with Background -->
    <FaqList
      title="GTA 6 Price &amp; Pre-Order FAQ"
      subtitle="Official answers regarding editions, pricing, digital upgrades, and retailer bonus perks."
      badge="Take-Two Pricing Facts"
      items={faqs}
    />

    <Keywords />

    <Sources items={[sources.taketwo, sources.playstation, sources.rockstar, sources.preload]} />
  </InnerPageLayout>
</Base>

<style>
/* ── TOP 2-COLUMN HEADER OVERVIEW ────────────────────────────── */
.price-hero-split {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 2.5rem;
  align-items: center;
  margin-bottom: 3.5rem;
}

.price-badge {
  display: inline-block;
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.72rem;
  font-weight: 700;
  color: #f7c948;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  background: rgba(247, 201, 72, 0.12);
  padding: 0.35rem 0.85rem;
  border-radius: 50px;
  margin-bottom: 1rem;
}

.price-main-heading {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: clamp(1.8rem, 3.2vw, 2.6rem);
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.03em;
  margin: 0 0 1rem;
  line-height: 1.2;
}

.price-lead {
  font-size: 1.05rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 1.5rem;
}

.price-hero-card {
  width: 100%;
  max-width: 100%;
  min-width: 0; /* Prevents grid cell from blowing out */
  box-sizing: border-box;
  background: linear-gradient(135deg, rgba(247, 201, 72, 0.08) 0%, rgba(14, 10, 24, 0.7) 100%);
  border: 1px solid rgba(247, 201, 72, 0.25);
  border-radius: 1.5rem;
  padding: 2rem 2.25rem;
  backdrop-filter: blur(14px);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  overflow: hidden;
}

.ph-card-inner {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.ph-pill {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.7rem;
  font-weight: 700;
  color: #f7c948;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  display: block;
  margin-bottom: 1.25rem;
}

.ph-prices {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 0.85rem;
  margin-bottom: 1.5rem;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.ph-price-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.35rem;
  min-width: 0;
}

.ph-label {
  font-size: clamp(0.72rem, 2.2vw, 0.85rem);
  color: rgba(255, 255, 255, 0.6);
  font-family: var(--display, 'Unbounded', sans-serif);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.ph-val {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: clamp(1.35rem, 5vw, 2.2rem);
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.04em;
  white-space: nowrap;
  line-height: 1.1;
}

.ph-gold {
  color: #f7c948;
}

.ph-divider {
  width: 1px;
  height: 48px;
  background: rgba(255, 255, 255, 0.12);
  flex-shrink: 0;
}

.ph-note {
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
  text-align: center;
  margin: 0;
  padding-top: 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

/* ── EDITION CARDS SECTION ───────────────────────────────────── */
.price-cards-section {
  margin-bottom: 4rem;
}

.price-section-title {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  font-weight: 800;
  color: #fff;
  margin-bottom: 1.75rem;
  letter-spacing: -0.03em;
}

.edition-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  gap: 1.5rem;
  width: 100%;
  box-sizing: border-box;
}

.edition-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 1.5rem;
  padding: 2.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  position: relative;
  overflow: hidden;
}
.edition-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
}

.edition-card--ultimate {
  border-color: rgba(247, 201, 72, 0.35);
  background: linear-gradient(180deg, rgba(247, 201, 72, 0.04) 0%, rgba(20, 16, 32, 0.6) 100%);
}
.edition-card--ultimate:hover {
  border-color: rgba(247, 201, 72, 0.6);
  box-shadow: 0 25px 60px rgba(247, 201, 72, 0.15);
}

.edition-card-badge {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.7);
  padding: 0.35rem 0.9rem;
  border-radius: 50px;
  width: fit-content;
}
.edition-card-badge--gold {
  background: rgba(247, 201, 72, 0.15);
  color: #f7c948;
}

.edition-card-price {
  font-size: 3.5rem;
  font-family: var(--display, 'Unbounded', sans-serif);
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.04em;
  line-height: 1;
}
.edition-card-price--gold { color: #f7c948; }

.edition-card-tag {
  font-size: 0.82rem;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-top: -0.5rem;
}

.edition-card-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex: 1;
}
.edition-card-list li {
  font-size: 0.95rem;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.5;
}

.edition-card-cta {
  display: block;
  text-align: center;
  padding: 1rem 1.8rem;
  border-radius: 50px;
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.88rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-decoration: none;
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.15);
  transition: all 0.25s ease;
  margin-top: auto;
}
.edition-card-cta:hover { background: rgba(255, 255, 255, 0.16); transform: translateY(-2px); }
.edition-card-cta--gold { background: #f7c948; color: #05040a; border-color: #f7c948; }
.edition-card-cta--gold:hover { background: #ffd84a; box-shadow: 0 10px 25px rgba(247, 201, 72, 0.35); }

/* ── TWO-COLUMN COMPARISON & TABLE ───────────────────────────── */
.two-col-compare {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 2.5rem;
  align-items: stretch;
  margin-bottom: 4rem;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.compare-table-col {
  width: 100%;
  max-width: 100%;
  min-width: 0; /* CRITICAL: prevents grid cell blowout on mobile */
  box-sizing: border-box;
}

.compare-visual-col {
  width: 100%;
  max-width: 100%;
  min-width: 0; /* CRITICAL: prevents grid cell blowout on mobile */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.price-table-hint {
  display: none;
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.68rem;
  font-weight: 600;
  color: #f7c948;
  letter-spacing: 0.04em;
  margin-bottom: 0.6rem;
}

.price-table-wrap {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: 1.25rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.02);
  box-sizing: border-box;
}
.price-table-wrap table {
  width: 100%;
  min-width: 320px;
  border-collapse: collapse;
}
.price-table-wrap th,
.price-table-wrap td {
  padding: 1rem 1.2rem;
  text-align: left;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  font-size: 0.92rem;
  color: rgba(255, 255, 255, 0.8);
}
.price-table-wrap thead th {
  background: rgba(255, 255, 255, 0.04);
  color: #fff;
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.78rem;
  letter-spacing: 0.05em;
}
.th-price { display: block; font-size: 1.05rem; font-weight: 800; color: #fff; }
.th-price--gold { color: #f7c948; }
.check { color: #4ade80; font-size: 1.1rem; }
.cross { color: rgba(255, 255, 255, 0.3); font-size: 1.1rem; }

.ultimate-spotlight-card {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 1.5rem;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  height: 100%;
  display: flex;
  flex-direction: column;
}

.usc-img-wrap {
  position: relative;
  height: 200px;
  background: #000;
}
.usc-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.usc-tag {
  position: absolute;
  top: 12px;
  left: 12px;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(4px);
  color: #f7c948;
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.65rem;
  font-weight: 700;
  padding: 0.25rem 0.65rem;
  border-radius: 4px;
}

.usc-body {
  padding: 1.75rem;
}

.usc-title {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 1.15rem;
  font-weight: 700;
  color: #fff;
  margin: 0 0 0.65rem;
}

.usc-desc {
  font-size: 0.88rem;
  color: rgba(255, 255, 255, 0.68);
  line-height: 1.6;
  margin: 0;
}

/* ── TWO-COLUMN PRE-ORDER PERKS ──────────────────────────────── */
.two-col-preorder-perks {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
  margin-bottom: 4rem;
}

.perks-title {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 1.25rem;
  font-weight: 700;
  color: #fff;
  margin: 0 0 1.5rem;
}

.price-timeline {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  border-left: 2px solid rgba(247, 201, 72, 0.35);
