---
import Base from '../layouts/Base.astro';

const title = 'Page not found | Vareno';
const description = 'That page is not on the Vareno GTA 6 guide. Try the release date, price, map, or home page.';
---

<Base title={title} description={description} noindex={true}>
  <article class="shell prose">
    <h1>Page not found</h1>
    <p class="lead">That address is not on this guide. The release date, the price, and the map are linked below.</p>
    <ul class="guide-index">
      <li><a href="/">GTA 6 home</a></li>
      <li><a href="/release-date">GTA 6 release date</a></li>
      <li><a href="/price">How much is GTA 6</a></li>
      <li><a href="/map">GTA 6 map</a></li>
    </ul>
  </article>
</Base>
