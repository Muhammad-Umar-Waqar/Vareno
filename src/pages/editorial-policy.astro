---
import Base from '../layouts/Base.astro';
import InnerPageLayout from '../components/InnerPageLayout.astro';
import { breadcrumbSchema } from '../lib/seo';

const title = 'Editorial Policy | Vareno GTA 6 Guide';
const description =
  'Vareno cites Rockstar and Take-Two for GTA 6 dates and prices, labels updates, and provides verified primary source citations.';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Editorial policy', path: '/editorial-policy' },
];
---

<Base title={title} description={description} schemas={[breadcrumbSchema(crumbs)]}>
  <InnerPageLayout
    pageTitle="Editorial Policy"
    crumbs={crumbs}
    heroImg="/images/gta6-rooftop.webp"
    accentColor="#f5b400"
  >
    <div class="legal-card" data-reveal>
      <p class="legal-lead">
        Dates, prices, hardware specifications, and narrative synopses on Vareno are directly anchored to verified primary sources: official Rockstar Games Newswire publications and Take-Two Interactive SEC filings.
      </p>

      <div class="legal-divider"></div>

      <section class="legal-section">
        <h2>What We Publish (Verified Standards)</h2>
        <ul class="editorial-bullets">
          <li><strong>Current Launch Milestone:</strong> November 19, 2026 lock, citing Take-Two Interactive shareholder earnings releases.</li>
          <li><strong>Official Pricing:</strong> Standard Edition ($79.99 USD) and Ultimate Edition ($99.99 USD) with regional currency disclaimers.</li>
          <li><strong>Official Character Lore:</strong> Verbatim quotes and official press synopses for Lucia Caminos and Jason Duval.</li>
          <li><strong>Media Catalog:</strong> Official Trailer 1, Trailer 2, and Developer extended previews with verified timestamps.</li>
        </ul>
      </section>

      <section class="legal-section">
        <h2>What We Filter & Fact-Check</h2>
        <ul class="editorial-bullets">
          <li><strong>DMCA / Leaked Assets:</strong> We do not host, distribute, or stream illegally extracted source code or copyright-infringing footage.</li>
          <li><strong>Unsourced Cast Rumors:</strong> Voice actors and character models are labeled as community speculation until officially announced by Rockstar Games.</li>
          <li><strong>Viral Fabrication:</strong> Clickbait claims (e.g. the fake $150 standard price tag or Netflix day-one streaming) are investigated and explicitly debunked.</li>
        </ul>
      </section>

      <div class="legal-footer">
        <span>Policy updated: November 16, 2026</span>
        <a href="/contact" class="legal-link">Submit Source Tip →</a>
      </div>
    </div>
  </InnerPageLayout>
</Base>

<style>
.legal-card {
  max-width: 82ch;
  background: rgba(16, 19, 26, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 1.25rem;
  padding: clamp(1.5rem, 4vw, 2.75rem);
  backdrop-filter: blur(16px);
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.85);
  font-size: 1.05rem;
}

.legal-lead {
  font-size: 1.15rem;
  line-height: 1.7;
  color: #fff;
  margin: 0;
}

.legal-divider {
  height: 1px;
  background: linear-gradient(90deg, rgba(245, 180, 0, 0.4), rgba(255, 255, 255, 0.06));
  margin: 1.75rem 0;
}

.legal-section {
  margin-bottom: 2rem;
}

.legal-section h2 {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 1.2rem;
  font-weight: 700;
  color: #fff;
  margin: 0 0 0.75rem;
}

.editorial-bullets {
  padding-left: 1.5rem;
  margin: 0.5rem 0 1rem;
}

.editorial-bullets li {
  margin-bottom: 0.65rem;
}

.editorial-bullets strong {
  color: #fff;
}

.legal-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 0.88rem;
  color: rgba(255, 255, 255, 0.5);
  font-family: var(--display, 'Unbounded', sans-serif);
}

.legal-link {
  color: #f5b400;
  text-decoration: none;
  font-weight: 600;
}

.legal-link:hover {
  text-decoration: underline;
}

/* ═══════════════════════════════════════════════════════════════════════════
   LIGHT MODE OVERRIDES
   ═══════════════════════════════════════════════════════════════════════════ */
:global(html[data-theme="light"]) .legal-card {
  background: #ffffff;
  border-color: rgba(15, 23, 42, 0.12);
  box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
  color: #334155;
}

:global(html[data-theme="light"]) .legal-lead {
  color: #090d16;
}

:global(html[data-theme="light"]) .legal-section h2 {
  color: #090d16;
}

:global(html[data-theme="light"]) .editorial-bullets strong {
  color: #090d16;
}

:global(html[data-theme="light"]) .legal-divider {
  background: linear-gradient(90deg, rgba(200, 110, 0, 0.35), rgba(15, 23, 42, 0.08));
}

:global(html[data-theme="light"]) .legal-footer {
  border-top-color: rgba(15, 23, 42, 0.1);
  color: #64748b;
}

:global(html[data-theme="light"]) .legal-link {
  color: #a85800;
}
</style>
