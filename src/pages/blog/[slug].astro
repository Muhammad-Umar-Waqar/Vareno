---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import InnerPageLayout from '../../components/InnerPageLayout.astro';
import FaqList from '../../components/FaqList.astro';
import Keywords from '../../components/Keywords.astro';
import { blogPostingSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}`;
const seoTitle = `${post.data.title} | Vareno`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
  { name: post.data.title, path },
];

const schemas: any[] = [
  blogPostingSchema({
    headline: post.data.title,
    description: post.data.description,
    path,
    published: post.data.pubDate,
    modified: post.data.updatedDate,
  }),
  breadcrumbSchema(crumbs),
];

if (post.data.faqs && post.data.faqs.length > 0) {
  schemas.push(faqSchema(post.data.faqs));
}
---

<Base
  title={seoTitle}
  description={post.data.description}
  ogType="article"
  schemas={schemas}
>
  <InnerPageLayout
    pageTitle={post.data.title}
    crumbs={crumbs}
    heroImg="/images/gta6-rooftop.webp"
    accentColor="#f7c948"
  >
    <div class="article-meta-bar">
      <Byline
        updated={post.data.updatedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
        updatedISO={post.data.updatedDate.toISOString().slice(0, 10)}
      />
      {post.data.tag && (
        <span class="article-tag-badge">{post.data.tag}</span>
      )}
    </div>

    <div class="article-content" data-reveal>
      <Content />
    </div>

    {post.data.faqs && post.data.faqs.length > 0 && (
      <div class="article-faqs-wrapper" data-reveal>
        <FaqList
          items={post.data.faqs}
          badge="Direct AI Answer Extraction"
          title="Key Questions & Verified Answers"
          subtitle="Clear, 18-token structured answers engineered for Google AI Overviews, Perplexity, and citation accuracy."
        />
      </div>
    )}

    <div class="article-nav" data-reveal>
      <a class="article-back-link" href="/blog">← Back to All GTA 6 Reports</a>
    </div>

    <Keywords />
  </InnerPageLayout>
</Base>

<style>
.article-meta-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.article-tag-badge {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 0.35rem 0.75rem;
  border-radius: 999px;
  background: rgba(247, 201, 72, 0.15);
  color: #f7c948;
  border: 1px solid rgba(247, 201, 72, 0.3);
}

.article-content {
  max-width: 85ch;
  line-height: 1.8;
  color: rgba(255,255,255,0.85);
  font-size: 1.05rem;
  margin-bottom: 2.5rem;
}

.article-content :global(h2) {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: clamp(1.3rem, 2.5vw, 1.8rem);
  font-weight: 700;
  color: #fff;
  margin: 2.5rem 0 1rem;
  letter-spacing: -0.01em;
}

.article-content :global(h3) {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 1.15rem;
  font-weight: 600;
  color: #f7c948;
  margin: 1.75rem 0 0.75rem;
}

.article-content :global(p) {
  margin-bottom: 1.25rem;
}

.article-content :global(a) {
  color: #f7c948;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.article-content :global(ul),
.article-content :global(ol) {
  padding-left: 1.5rem;
  margin-bottom: 1.5rem;
}

.article-content :global(li) {
  margin-bottom: 0.5rem;
}

.article-content :global(table) {
  width: 100%;
  border-collapse: collapse;
  margin: 2rem 0;
  font-size: 0.92rem;
  background: rgba(16, 19, 26, 0.7);
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.article-content :global(th) {
  background: rgba(255, 255, 255, 0.06);
  color: #fff;
  font-weight: 700;
  padding: 0.85rem 1rem;
  text-align: left;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.article-content :global(td) {
  padding: 0.85rem 1rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.88);
}

.article-content :global(tr:last-child td) {
  border-bottom: none;
}

.article-content :global(blockquote) {
  margin: 1.75rem 0;
  padding: 1.15rem 1.4rem;
  background: rgba(247, 201, 72, 0.06);
  border-left: 4px solid #f7c948;
  border-radius: 0 10px 10px 0;
  color: rgba(255, 255, 255, 0.95);
  font-style: italic;
}

.article-faqs-wrapper {
  margin: 3rem 0;
}

.article-nav {
  margin-bottom: 3rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255,255,255,0.1);
}

.article-back-link {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.9rem;
  color: #f7c948;
  text-decoration: none;
  font-weight: 600;
}

/* ═══════════════════════════════════════════════════════════════════════════
   LIGHT MODE OVERRIDES
   ═══════════════════════════════════════════════════════════════════════════ */
:global(html[data-theme="light"]) .article-content {
  color: #334155;
}

:global(html[data-theme="light"]) .article-content :global(h2),
:global(html[data-theme="light"]) .article-content :global(h3) {
  color: #090d16;
}

:global(html[data-theme="light"]) .article-content :global(table) {
  background: #ffffff;
  border-color: rgba(15, 23, 42, 0.12);
  box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
}

:global(html[data-theme="light"]) .article-content :global(th) {
  background: #f1f5f9;
  color: #090d16;
  border-bottom-color: rgba(15, 23, 42, 0.12);
}

:global(html[data-theme="light"]) .article-content :global(td) {
  color: #334155;
  border-bottom-color: rgba(15, 23, 42, 0.08);
}

:global(html[data-theme="light"]) .article-content :global(blockquote) {
  background: rgba(200, 110, 0, 0.06);
  border-left-color: #c86e00;
  color: #1e293b;
}

:global(html[data-theme="light"]) .article-tag-badge {
  background: #fef3c7;
  color: #92400e;
  border-color: rgba(200, 110, 0, 0.25);
}

:global(html[data-theme="light"]) .article-nav {
  border-top-color: rgba(15, 23, 42, 0.08);
}

:global(html[data-theme="light"]) .article-back-link {
  color: #c86e00;
}
</style>
