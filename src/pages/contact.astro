---
import Base from '../layouts/Base.astro';
import InnerPageLayout from '../components/InnerPageLayout.astro';
import { socials } from '../data/site';
import { breadcrumbSchema } from '../lib/seo';

const title = 'Contact Vareno | Corrections & Inquiries';
const description =
  'Send GTA 6 guide corrections or editorial inquiries to Vareno across YouTube, TikTok, or Instagram.';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact' },
];
---

<Base title={title} description={description} schemas={[breadcrumbSchema(crumbs)]}>
  <InnerPageLayout
    pageTitle="Contact Vareno"
    crumbs={crumbs}
    heroImg="/images/gta6-rooftop.webp"
    accentColor="#f5b400"
  >
    <div class="legal-card" data-reveal>
      <p class="legal-lead">
        Spotted a discrepancy in a countdown timezone, a broken console store link, or a new Take-Two press announcement? We welcome direct community tips and corrections.
      </p>

      <div class="legal-divider"></div>

      <section class="legal-section">
        <h2>Direct Social Channels</h2>
        <p>
          Our editorial team actively monitors direct messages across our verified social channels:
        </p>
        <div class="social-links-grid">
          {socials.map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer" class="social-pill">
              <span>{item.name} (@VarenoPlay)</span>
              <span class="social-arrow">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="legal-section">
        <h2>Submitting a Data Correction</h2>
        <p>
          When reporting an update (e.g. unexpected release movement or revised retailer pricing), please include:
        </p>
        <ul class="contact-bullets">
          <li>The specific Vareno guide URL.</li>
          <li>A direct link to the primary source (Rockstar Games Newswire, Take-Two SEC filing, or official console store listing).</li>
        </ul>
        <p>
          All submissions are reviewed according to our <a href="/editorial-policy" class="gold-link">Editorial Verification Policy</a>.
        </p>
      </section>
    </div>
  </InnerPageLayout>
</Base>

<style>
.legal-card {
  max-width: 82ch;
  background: rgba(16, 19, 26, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 1.25rem;
  padding: clamp(1.5rem, 4vw, 2.75rem);
  backdrop-filter: blur(16px);
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.85);
  font-size: 1.05rem;
}

.legal-lead {
  font-size: 1.15rem;
  line-height: 1.7;
  color: #fff;
  margin: 0;
}

.legal-divider {
  height: 1px;
  background: linear-gradient(90deg, rgba(245, 180, 0, 0.4), rgba(255, 255, 255, 0.06));
  margin: 1.75rem 0;
}

.legal-section {
  margin-bottom: 2rem;
}

.legal-section h2 {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 1.2rem;
  font-weight: 700;
  color: #fff;
  margin: 0 0 0.75rem;
}

.legal-section p {
  margin: 0 0 0.85rem;
}

.contact-bullets {
  padding-left: 1.5rem;
  margin: 0.5rem 0 1rem;
}

.contact-bullets li {
  margin-bottom: 0.5rem;
}

.gold-link {
  color: #f5b400;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.social-links-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 1rem;
}

.social-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1.2rem;
  border-radius: 999px;
  background: rgba(245, 180, 0, 0.1);
  border: 1px solid rgba(245, 180, 0, 0.3);
  color: #fff;
  text-decoration: none;
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.82rem;
  font-weight: 600;
  transition: all 0.2s ease;
}

.social-pill:hover {
  background: #f5b400;
  color: #000;
  transform: translateY(-2px);
}

.social-arrow {
  color: #f5b400;
  font-size: 0.95rem;
}

.social-pill:hover .social-arrow {
  color: #000;
}

/* ═══════════════════════════════════════════════════════════════════════════
   LIGHT MODE OVERRIDES
   ═══════════════════════════════════════════════════════════════════════════ */
:global(html[data-theme="light"]) .legal-card {
  background: #ffffff;
  border-color: rgba(15, 23, 42, 0.12);
  box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
  color: #334155;
}

:global(html[data-theme="light"]) .legal-lead {
  color: #090d16;
}

:global(html[data-theme="light"]) .legal-section h2 {
  color: #090d16;
}

:global(html[data-theme="light"]) .legal-divider {
  background: linear-gradient(90deg, rgba(200, 110, 0, 0.35), rgba(15, 23, 42, 0.08));
}

:global(html[data-theme="light"]) .gold-link {
  color: #a85800;
}

:global(html[data-theme="light"]) .social-pill {
  background: #f1f5f9;
  border-color: rgba(15, 23, 42, 0.15);
  color: #090d16;
}

:global(html[data-theme="light"]) .social-arrow {
  color: #a85800;
}

:global(html[data-theme="light"]) .social-pill:hover {
  background: #c86e00;
  color: #ffffff;
}

:global(html[data-theme="light"]) .social-pill:hover .social-arrow {
  color: #ffffff;
}
</style>
