---
interface Crumb {
  name: string;
  path: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  {
    items.map((item, index) => (
      <span>
        {index > 0 && <span aria-hidden="true"> / </span>}
        {index === items.length - 1 ? <span>{item.name}</span> : <a href={item.path}>{item.name}</a>}
      </span>
    ))
  }
</nav>
