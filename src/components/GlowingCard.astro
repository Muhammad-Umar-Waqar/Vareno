---
/**
 * Aceternity-inspired Glowing Effect Cards
 * Features:
 * - Dynamic mouse-tracking radial border glow (--mouse-x, --mouse-y)
 * - Multi-color conic / radial light flare around pointer
 * - High-contrast glassmorphic card container with vector SVG icons
 */
import GuideIcon from './icons/GuideIcon.astro';

interface CardItem {
  icon?: string;
  badge?: string;
  title: string;
  desc: string;
  stat?: string;
  statLabel?: string;
  href?: string;
  glowColor?: string; // e.g. '#f7c948', '#ff5c8a', '#39d0ff'
}

interface Props {
  items: CardItem[];
  title?: string;
  subtitle?: string;
}

const { items, title, subtitle } = Astro.props;

const knownIcons = [
  'sync',
  'gamepad',
  'gift',
  'disc',
  'crown',
  'city',
  'mountain',
  'swamp',
  'island',
  'ssd',
  'sun',
  'mask',
  'road',
  'calendar',
  'price',
  'map',
  'people',
  'monitor',
  'play',
  'camera',
  'news',
  'store',
  'controller',
];
---

<div class="glowing-grid-wrap" data-reveal>
  {(title || subtitle) && (
    <div class="glowing-header">
      {title && <h3 class="glowing-main-title">{title}</h3>}
      {subtitle && <p class="glowing-main-sub">{subtitle}</p>}
    </div>
  )}

  <div class="glowing-grid" data-glowing-container>
    {items.map((item) => (
      <div
        class="glowing-card"
        data-glowing-card
        style={`--card-glow: ${item.glowColor || '#f7c948'};`}
      >
        <!-- Dynamic Mouse Glowing Overlay -->
        <div class="glowing-border-light" aria-hidden="true"></div>
        <div class="glowing-card-inner">
          <div class="glowing-card-top">
            {item.icon && (
              <span class="glowing-icon">
                {knownIcons.includes(item.icon) ? (
                  <GuideIcon name={item.icon as any} size={22} />
                ) : (
                  <span>{item.icon}</span>
                )}
              </span>
            )}
            {item.badge && <span class="glowing-badge">{item.badge}</span>}
          </div>

          <h4 class="glowing-card-title">{item.title}</h4>
          <p class="glowing-card-desc">{item.desc}</p>

          {(item.stat || item.href) && (
            <div class="glowing-card-bottom">
              {item.stat && (
                <div class="glowing-stat-box">
                  <span class="glowing-stat-val">{item.stat}</span>
                  {item.statLabel && <span class="glowing-stat-lbl">{item.statLabel}</span>}
                </div>
              )}
              {item.href && (
                <a class="glowing-link" href={item.href}>
                  <span>Explore</span>
                  <span class="glowing-arrow">→</span>
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  // Mouse position tracker for dynamic Aceternity radial glow
  const containers = document.querySelectorAll('[data-glowing-container]');

  containers.forEach((container) => {
    if (!(container instanceof HTMLElement)) return;

    container.addEventListener('mousemove', (e) => {
      const cards = container.querySelectorAll('[data-glowing-card]');
      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  });
</script>

<style>
.glowing-grid-wrap {
  margin: 3.5rem 0;
  width: 100%;
}

.glowing-header {
  text-align: center;
  max-width: 650px;
  margin: 0 auto 2.5rem;
}

.glowing-main-title {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: clamp(1.6rem, 3.2vw, 2.2rem);
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.03em;
  margin: 0 0 0.5rem;
}

.glowing-main-sub {
  color: rgba(255, 255, 255, 0.65);
  font-size: 0.95rem;
  line-height: 1.6;
  margin: 0;
}

/* 3-Column Responsive Grid with Max-Width Containment */
.glowing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  gap: 1.5rem;
  max-width: 1250px;
  margin: 0 auto;
}

.glowing-card {
  position: relative;
  border-radius: 1.25rem;
  padding: 1px; /* border space for the glow */
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.glowing-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5), 0 0 24px var(--card-glow, rgba(247, 201, 72, 0.15));
}

/* Mouse-following border light */
.glowing-border-light {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background: radial-gradient(
    400px circle at var(--mouse-x, -500px) var(--mouse-y, -500px),
    var(--card-glow, #f7c948) 0%,
    rgba(255, 255, 255, 0.15) 30%,
    transparent 70%
  );
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: 1;
}

.glowing-card:hover .glowing-border-light {
  opacity: 1;
}

/* Card inner content */
.glowing-card-inner {
  position: relative;
  z-index: 2;
  background: #0c0915;
  border-radius: calc(1.25rem - 1px);
  padding: 1.85rem;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
}

.glowing-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.25rem;
}

.glowing-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: var(--card-glow, #f7c948);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
}

.glowing-card:hover .glowing-icon {
  transform: scale(1.08);
  background: rgba(255, 255, 255, 0.1);
  border-color: var(--card-glow, #f7c948);
  box-shadow: 0 0 20px var(--card-glow, rgba(247, 201, 72, 0.3));
}

.glowing-badge {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--card-glow, #f7c948);
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 0.25rem 0.65rem;
  border-radius: 50px;
}

.glowing-card-title {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 1.15rem;
  font-weight: 700;
  color: #fff;
  margin: 0 0 0.5rem;
  letter-spacing: -0.02em;
  line-height: 1.3;
}

.glowing-card-desc {
  font-size: 0.88rem;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.6;
  margin: 0 0 1.5rem;
  flex: 1;
}

.glowing-card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-top: 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.glowing-stat-box {
  display: flex;
  flex-direction: column;
}

.glowing-stat-val {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 1.1rem;
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.02em;
}

.glowing-stat-lbl {
  font-size: 0.72rem;
  color: rgba(255, 255, 255, 0.5);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.glowing-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--card-glow, #f7c948);
  text-decoration: none;
  transition: transform 0.2s ease;
}

.glowing-link:hover .glowing-arrow {
  transform: translateX(4px);
}

.glowing-arrow {
  transition: transform 0.2s ease;
}

@media (max-width: 768px) {
  .glowing-grid {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .glowing-card-inner {
    padding: 1.4rem 1.2rem;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   LIGHT MODE OVERRIDES
   ═══════════════════════════════════════════════════════════════════════════ */
:global(html[data-theme="light"]) .glowing-main-title {
  color: #090d16;
}

:global(html[data-theme="light"]) .glowing-main-sub {
  color: #475569;
}

:global(html[data-theme="light"]) .glowing-card {
  background: rgba(15, 23, 42, 0.08);
}

:global(html[data-theme="light"]) .glowing-card:hover {
  box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08), 0 0 24px var(--card-glow, rgba(200, 110, 0, 0.15));
}

:global(html[data-theme="light"]) .glowing-card-inner {
  background: #ffffff;
  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.9), 0 2px 10px rgba(15, 23, 42, 0.04);
}

:global(html[data-theme="light"]) .glowing-card-title {
  color: #090d16;
}

:global(html[data-theme="light"]) .glowing-card-desc {
  color: #334155;
}

:global(html[data-theme="light"]) .glowing-stat-val {
  color: #090d16;
}

:global(html[data-theme="light"]) .glowing-stat-lbl {
  color: #64748b;
}

:global(html[data-theme="light"]) .glowing-icon {
  background: #f8fafc;
  border-color: rgba(15, 23, 42, 0.12);
  color: var(--card-glow, #c86e00);
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
}

:global(html[data-theme="light"]) .glowing-badge {
  background: #f1f5f9;
  border-color: rgba(15, 23, 42, 0.12);
  color: #0f172a;
}

:global(html[data-theme="light"]) .glowing-card-bottom {
  border-top-color: rgba(15, 23, 42, 0.08);
}

:global(html[data-theme="light"]) .glowing-link {
  color: var(--card-glow, #a85800);
}
</style>
