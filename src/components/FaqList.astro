---
/**
 * Aceternity-inspired Simple FAQs with Background
 * Features:
 * - Subtle ambient glow and dotted background grid
 * - Expandable accordion with smooth transitions
 * - Badges, numbered items, and clean typography
 * - Accessible details/summary or click toggle
 */

interface Faq {
  q: string;
  a: string;
  tag?: string;
}

interface Props {
  items: Faq[];
  title?: string;
  subtitle?: string;
  badge?: string;
}

const {
  items,
  title = "Frequently Asked Questions",
  subtitle = "Direct, verified facts sourced from Rockstar Games press releases and Take-Two Interactive SEC filings.",
  badge = "Rockstar Verified Intel",
} = Astro.props;
---

<section class="faq-aceternity" data-reveal aria-labelledby="faq-heading">
  <!-- Subtle ambient background glow & dotted grid -->
  <div class="faq-bg-ambient" aria-hidden="true"></div>
  <div class="faq-bg-grid" aria-hidden="true"></div>

  <div class="faq-container">
    <!-- Header -->
    <div class="faq-header">
      <span class="faq-badge">
        <span class="faq-badge-dot"></span>
        {badge}
      </span>
      <h2 id="faq-heading" class="faq-title">{title}</h2>
      <p class="faq-subtitle">{subtitle}</p>
    </div>

    <!-- Accordion List -->
    <div class="faq-accordion-list" role="region" aria-label="Questions and answers">
      {items.map((item, index) => {
        const num = String(index + 1).padStart(2, '0');
        return (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-trigger">
              <div class="faq-trigger-left">
                <span class="faq-num">{num}</span>
                <span class="faq-question">{item.q}</span>
              </div>
              <div class="faq-icon-wrap" aria-hidden="true">
                <svg class="faq-icon-plus" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </div>
            </summary>
            <div class="faq-content">
              <div class="faq-answer-inner">
                <p class="faq-answer">{item.a}</p>
                <div class="faq-footer-meta">
                  <span class="faq-source-pill">Official Source: Rockstar Games</span>
                  <span class="faq-check">✓ Verified fact</span>
                </div>
              </div>
            </div>
          </details>
        );
      })}
    </div>
  </div>
</section>

<style>
.faq-aceternity {
  position: relative;
  margin: 4rem 0 3rem;
  padding: 4rem 2rem;
  border-radius: 1.75rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(10, 8, 18, 0.6);
  backdrop-filter: blur(20px);
  overflow: hidden;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
}

/* Ambient glow & dot grid background */
.faq-bg-ambient {
  position: absolute;
  top: -20%;
  left: 30%;
  width: 500px;
  height: 400px;
  background: radial-gradient(circle, rgba(247, 201, 72, 0.12) 0%, rgba(255, 92, 138, 0.06) 50%, transparent 70%);
  filter: blur(60px);
  pointer-events: none;
  z-index: 0;
}

.faq-bg-grid {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px);
  background-size: 24px 24px;
  mask-image: radial-gradient(ellipse at 50% 30%, black 40%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 30%, black 40%, transparent 80%);
  pointer-events: none;
  opacity: 0.6;
  z-index: 0;
}

.faq-container {
  position: relative;
  z-index: 1;
  max-width: 900px;
  margin: 0 auto;
}

/* Header */
.faq-header {
  text-align: center;
  margin-bottom: 3rem;
}

.faq-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(247, 201, 72, 0.1);
  border: 1px solid rgba(247, 201, 72, 0.25);
  color: #f7c948;
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 0.4rem 1rem;
  border-radius: 50px;
  margin-bottom: 1.25rem;
}

.faq-badge-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #f7c948;
  box-shadow: 0 0 8px #f7c948;
}

.faq-title {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: clamp(1.75rem, 3.5vw, 2.6rem);
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.03em;
  margin: 0 0 1rem;
  line-height: 1.2;
}

.faq-subtitle {
  color: rgba(255, 255, 255, 0.65);
  font-size: 1rem;
  line-height: 1.6;
  max-width: 600px;
  margin: 0 auto;
}

/* Accordion list */
.faq-accordion-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.faq-item {
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 1.2rem;
  overflow: hidden;
  transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
}

.faq-item:hover {
  background: rgba(255, 255, 255, 0.045);
  border-color: rgba(247, 201, 72, 0.3);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.faq-item[open] {
  border-color: rgba(247, 201, 72, 0.35);
  background: rgba(255, 255, 255, 0.04);
}

/* Trigger / summary */
.faq-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  padding: 1.4rem 1.75rem;
  cursor: pointer;
  user-select: none;
  list-style: none;
}
.faq-trigger::-webkit-details-marker {
  display: none;
}

.faq-trigger-left {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  text-align: left;
}

.faq-num {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.85rem;
  font-weight: 700;
  color: #f7c948;
  background: rgba(247, 201, 72, 0.1);
  border: 1px solid rgba(247, 201, 72, 0.2);
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.faq-question {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: clamp(1rem, 1.8vw, 1.15rem);
  font-weight: 600;
  color: #fff;
  line-height: 1.4;
  letter-spacing: -0.01em;
}

.faq-icon-wrap {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #fff;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s, color 0.2s;
}

.faq-item:hover .faq-icon-wrap {
  background: #f7c948;
  color: #05040a;
  border-color: #f7c948;
}

.faq-item[open] .faq-icon-wrap {
  transform: rotate(45deg);
  background: #f7c948;
  color: #05040a;
}

/* Content / Answer */
.faq-content {
  padding: 0 1.75rem 1.6rem 4.5rem;
  animation: faqFade 0.3s ease-out;
}

@keyframes faqFade {
  from { opacity: 0; transform: translateY(-6px); }
  to { opacity: 1; transform: translateY(0); }
}

.faq-answer {
  color: rgba(255, 255, 255, 0.82);
  font-size: 1rem;
  line-height: 1.75;
  margin: 0 0 1.25rem;
}

.faq-footer-meta {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.faq-source-pill {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.5);
  font-family: var(--display, 'Unbounded', sans-serif);
}

.faq-check {
  font-size: 0.75rem;
  color: #4ade80;
  font-weight: 600;
}

@media (max-width: 640px) {
  .faq-aceternity {
    padding: 2.5rem 1.25rem;
  }
  .faq-trigger {
    padding: 1.2rem 1rem;
    gap: 0.75rem;
  }
  .faq-trigger-left {
    gap: 0.75rem;
  }
  .faq-content {
    padding: 0 1rem 1.25rem 1rem;
  }
  .faq-num {
    width: 26px;
    height: 26px;
    font-size: 0.75rem;
  }
}
</style>
