---
import { logo } from '../data/images';
import { primaryNav, moreNav, nav, stores } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const buyHref = stores[0]?.href ?? '/price';

const isMoreActive = moreNav.some(
  (item) => path === item.href || (item.href === '/blog' && path.startsWith('/blog'))
);

// Nav icon SVG paths (simple, clean, 20x20 viewBox)
const navIcons: Record<string, string> = {
  '/release-date':     'M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zM4 9h16M8 4V2M16 4V2M8 14h2M12 14h2',
  '/tricks':           'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
  '/leaks':            'M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z',
  '/price':            'M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 5v1.5m0 7V17m-2.5-9C10 7.6 10.9 7 12 7c1.4 0 2.5.9 2.5 2S13.4 11 12 11s-2.5.9-2.5 2 1.1 2 2.5 2c1.1 0 2-.6 2.5-1.5',
  '/map':              'M9 4L3 7v13l6-3 6 3 6-3V4l-6 3-6-3zM9 4v13M15 7v13',
  '/characters/lucia': 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm-7 8c0-3.9 3.1-7 7-7s7 3.1 7 7',
  '/platforms':        'M2 6h20v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6zm7 15h6M12 18v3',
  '/trailers':         'M5 3l14 9-14 9V3z',
  '/blog':             'M4 6h16M4 10h16M4 14h10',
  '/tools/portrait':   'M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2zM12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z',
};
---

<!-- ════════════════════════════════════════════════
     HEADER — Aceternity-inspired floating pill nav
     ════════════════════════════════════════════════ -->
<header class="site-header" id="site-header">
  <div class="hdr-inner shell">

    <!-- Brand -->
    <a class="hdr-brand" href="/">
      <img src={logo.src} width={36} height={36} alt="Vareno Play" class="hdr-brand-logo" />
      <span class="hdr-brand-text">Vareno Play</span>
    </a>

    <!-- Desktop floating pill nav (Aceternity UI style) -->
    <nav class="hdr-pill-nav" id="hdr-desktop-nav" aria-label="Main navigation">
      {primaryNav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'hdr-pill-link',
            {
              'is-active':
                path === item.href ||
                (item.href === '/tricks' && path.startsWith('/tricks')) ||
                (item.href === '/leaks' && path.startsWith('/leaks')),
            },
          ]}
          aria-current={path === item.href ? 'page' : undefined}
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hdr-link-icon">
            {navIcons[item.href] && navIcons[item.href].split('M').filter(Boolean).map((d) => (
              <path d={'M' + d} />
            ))}
          </svg>
          {item.label}
        </a>
      ))}

      <!-- Aceternity Floating "More ▾" Dropdown -->
      <div class="hdr-more-wrap" id="hdr-more-wrap">
        <button
          type="button"
          class:list={['hdr-pill-link', 'hdr-more-btn', { 'is-active': isMoreActive }]}
          id="hdr-more-btn"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="More navigation options"
        >
          <span>More</span>
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hdr-more-chevron">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </button>

        <div class="hdr-more-menu" id="hdr-more-menu" role="menu" aria-label="More pages">
          <div class="hdr-more-menu-inner">
            {moreNav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'hdr-more-item',
                  { 'is-active': path === item.href || (item.href === '/blog' && path.startsWith('/blog')) },
                ]}
                role="menuitem"
              >
                <span class="hdr-more-item-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {navIcons[item.href] && navIcons[item.href].split('M').filter(Boolean).map((d) => (
                      <path d={'M' + d} />
                    ))}
                  </svg>
                </span>
                <span class="hdr-more-item-text">
                  <span class="hdr-more-item-title">{item.label}</span>
                  <span class="hdr-more-item-desc">{item.desc}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </nav>

    <!-- Right side: Pre-order CTA + mobile menu button -->
    <div class="hdr-right">
      <a class="hdr-cta" href={buyHref} rel="sponsored noopener noreferrer">
        <span class="hdr-cta-dot" aria-hidden="true"></span>
        Pre-order
      </a>
      <button
        class="hdr-menu-btn"
        id="hdr-menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="hdr-drawer"
        aria-label="Open navigation menu"
      >
        <span class="hdr-menu-bar" id="bar1"></span>
        <span class="hdr-menu-bar" id="bar2"></span>
        <span class="hdr-menu-bar" id="bar3"></span>
      </button>
    </div>
  </div>
</header>

<!-- ════════════════════════════════════════════════
     MOBILE / TABLET DRAWER — glassmorphic slide-over panel
     ════════════════════════════════════════════════ -->
<div class="hdr-backdrop" id="hdr-backdrop" aria-hidden="true"></div>
<aside class="hdr-drawer" id="hdr-drawer" aria-label="Mobile navigation" aria-hidden="true">
  <div class="hdr-drawer-top">
    <a class="hdr-drawer-brand" href="/">
      <img src={logo.src} width={32} height={32} alt="" />
      <span>Vareno Play</span>
    </a>
    <button class="hdr-drawer-close" id="hdr-drawer-close" type="button" aria-label="Close menu">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <nav class="hdr-drawer-nav" aria-label="Mobile navigation links">
    {nav.map((item) => (
      <a
        href={item.href}
        class:list={[
          'hdr-drawer-link',
          {
            'is-active':
              path === item.href ||
              (item.href === '/tricks' && path.startsWith('/tricks')) ||
              (item.href === '/leaks' && path.startsWith('/leaks')) ||
              (item.href === '/blog' && path.startsWith('/blog')),
          },
        ]}
        aria-current={path === item.href ? 'page' : undefined}
      >
        <span class="hdr-drawer-link-icon">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {navIcons[item.href] && navIcons[item.href].split('M').filter(Boolean).map((d) => (
              <path d={'M' + d} />
            ))}
          </svg>
        </span>
        {item.label}
        <svg class="hdr-drawer-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </a>
    ))}
  </nav>

  <div class="hdr-drawer-footer">
    <a class="hdr-drawer-cta" href={buyHref} rel="sponsored noopener noreferrer">
      <span class="hdr-cta-dot" aria-hidden="true"></span>
      Pre-order GTA VI
    </a>
    <p class="hdr-drawer-note">Nov 19, 2026 · PS5 &amp; Xbox Series X|S</p>
  </div>
</aside>

<script>
  const btn      = document.getElementById('hdr-menu-btn')!;
  const drawer   = document.getElementById('hdr-drawer')!;
  const backdrop = document.getElementById('hdr-backdrop')!;
  const closeBtn = document.getElementById('hdr-drawer-close')!;
  const header   = document.getElementById('site-header')!;

  function openDrawer() {
    drawer.classList.add('is-open');
    backdrop.classList.add('is-visible');
    btn.setAttribute('aria-expanded', 'true');
    drawer.setAttribute('aria-hidden', 'false');
    btn.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer.classList.remove('is-open');
    backdrop.classList.remove('is-visible');
    btn.setAttribute('aria-expanded', 'false');
    drawer.setAttribute('aria-hidden', 'true');
    btn.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  btn.addEventListener('click', () =>
    drawer.classList.contains('is-open') ? closeDrawer() : openDrawer()
  );
  closeBtn.addEventListener('click', closeDrawer);
  backdrop.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDrawer();
      closeMoreMenu();
    }
  });

  // Scroll-based header elevation
  const onScroll = () => {
    header.classList.toggle('is-scrolled', window.scrollY > 60);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ══════════════════════════════════════════════════
  // Aceternity "More ▾" Dropdown Logic
  // ══════════════════════════════════════════════════
  const moreWrap = document.getElementById('hdr-more-wrap');
  const moreBtn  = document.getElementById('hdr-more-btn');
  const moreMenu = document.getElementById('hdr-more-menu');

  function openMoreMenu() {
    if (!moreWrap || !moreBtn || !moreMenu) return;
    moreWrap.classList.add('is-open');
    moreBtn.setAttribute('aria-expanded', 'true');
  }

  function closeMoreMenu() {
    if (!moreWrap || !moreBtn || !moreMenu) return;
    moreWrap.classList.remove('is-open');
    moreBtn.setAttribute('aria-expanded', 'false');
  }

  if (moreBtn && moreWrap) {
    moreBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = moreWrap.classList.contains('is-open');
      if (isOpen) {
        closeMoreMenu();
      } else {
        openMoreMenu();
      }
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!moreWrap.contains(e.target as Node)) {
        closeMoreMenu();
      }
    });

    // Desktop hover with small grace delay
    let hoverTimeout: number;
    moreWrap.addEventListener('mouseenter', () => {
      clearTimeout(hoverTimeout);
      openMoreMenu();
    });
    moreWrap.addEventListener('mouseleave', () => {
      hoverTimeout = window.setTimeout(closeMoreMenu, 250);
    });
  }
</script>

<style>
/* ══════════════════════════════════════════════════
   SITE HEADER — Aceternity floating pill style
   ══════════════════════════════════════════════════ */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(5, 6, 10, 0);
  border-bottom: 1px solid rgba(245, 180, 0, 0);
  transition: background 0.4s ease, border-color 0.4s ease, backdrop-filter 0.4s ease;
}

.site-header.is-scrolled {
  background: rgba(5, 6, 10, 0.88);
  border-bottom-color: rgba(245, 180, 0, 0.18);
  backdrop-filter: blur(20px) saturate(1.5);
  -webkit-backdrop-filter: blur(20px) saturate(1.5);
  box-shadow: 0 1px 40px rgba(0, 0, 0, 0.5);
}

.hdr-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-height: 4rem;
  padding: 0.5rem 0;
}

/* Brand */
.hdr-brand {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
  flex-shrink: 0;
}
.hdr-brand-logo {
  width: 36px;
  height: 36px;
  border-radius: 8px;
}
.hdr-brand-text {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--gold, #f5b400);
  letter-spacing: 0.03em;
  white-space: nowrap;
}

/* ── Desktop floating pill nav (Aceternity UI) ── */
.hdr-pill-nav {
  display: flex;
  align-items: center;
  gap: 0.2rem;
  background: radial-gradient(ellipse at top, rgba(245, 180, 0, 0.06), transparent 70%), rgba(16, 19, 26, 0.82);
  border: 1px solid rgba(245, 180, 0, 0.18);
  border-radius: 999px;
  padding: 0.32rem 0.45rem;
  backdrop-filter: blur(16px) saturate(1.4);
  -webkit-backdrop-filter: blur(16px) saturate(1.4);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

.hdr-pill-link {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.4rem 0.82rem;
  border-radius: 999px;
  font-family: var(--sans, 'Outfit', sans-serif);
  font-size: 0.84rem;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.72);
  text-decoration: none;
  transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  white-space: nowrap;
  border: none;
  background: transparent;
  cursor: pointer;
}
.hdr-pill-link:hover {
  color: #fff;
  background: rgba(245, 180, 0, 0.12);
  transform: translateY(-1px);
}
.hdr-pill-link.is-active {
  color: var(--gold, #f5b400);
  background: rgba(245, 180, 0, 0.16);
  font-weight: 600;
  box-shadow: 0 0 14px rgba(245, 180, 0, 0.2);
}
.hdr-link-icon {
  opacity: 0.75;
  flex-shrink: 0;
}
.hdr-pill-link:hover .hdr-link-icon,
.hdr-pill-link.is-active .hdr-link-icon {
  opacity: 1;
}

/* ── Aceternity "More ▾" Dropdown ── */
.hdr-more-wrap {
  position: relative;
}

.hdr-more-btn {
  display: flex;
  align-items: center;
  gap: 0.3rem;
}

.hdr-more-chevron {
  transition: transform 0.25s ease;
  opacity: 0.7;
}

.hdr-more-wrap.is-open .hdr-more-chevron {
  transform: rotate(180deg);
  opacity: 1;
}

.hdr-more-menu {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  min-width: 270px;
  background: rgba(13, 16, 23, 0.96);
  border: 1px solid rgba(245, 180, 0, 0.25);
  border-radius: 1rem;
  padding: 0.5rem;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65), 0 0 25px rgba(245, 180, 0, 0.12);
  backdrop-filter: blur(24px) saturate(1.5);
  -webkit-backdrop-filter: blur(24px) saturate(1.5);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px) scale(0.97);
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  z-index: 150;
}

.hdr-more-wrap.is-open .hdr-more-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
}

.hdr-more-menu-inner {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.hdr-more-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.6rem 0.75rem;
  border-radius: 0.75rem;
  text-decoration: none;
  transition: background 0.18s ease, transform 0.18s ease;
}

.hdr-more-item:hover {
  background: rgba(245, 180, 0, 0.12);
  transform: translateX(2px);
}

.hdr-more-item.is-active {
  background: rgba(245, 180, 0, 0.15);
  border: 1px solid rgba(245, 180, 0, 0.3);
}

.hdr-more-item-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 8px;
  color: rgba(255, 255, 255, 0.8);
  flex-shrink: 0;
}

.hdr-more-item:hover .hdr-more-item-icon,
.hdr-more-item.is-active .hdr-more-item-icon {
  background: rgba(245, 180, 0, 0.2);
  color: var(--gold, #f5b400);
}

.hdr-more-item-text {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}

.hdr-more-item-title {
  font-family: var(--sans, 'Outfit', sans-serif);
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--paper, #fff);
  line-height: 1.2;
}

.hdr-more-item-desc {
  font-size: 0.72rem;
  color: var(--muted, rgba(255, 255, 255, 0.5));
}

/* Right cluster */
.hdr-right {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  flex-shrink: 0;
}

/* Pre-order CTA */
.hdr-cta {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.45rem 1.15rem;
  background: linear-gradient(135deg, #f5b400 0%, #ff8c00 100%);
  color: #0a0a0a;
  font-family: var(--sans, 'Outfit', sans-serif);
  font-size: 0.84rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  border-radius: 999px;
  text-decoration: none;
  transition: opacity 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  white-space: nowrap;
  box-shadow: 0 4px 16px rgba(245, 180, 0, 0.3);
}
.hdr-cta:hover {
  opacity: 0.95;
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(245, 180, 0, 0.45);
}
.hdr-cta-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  animation: hdr-pulse 2s ease-in-out infinite;
}
@keyframes hdr-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.7); }
}

/* Hamburger button — hidden on desktop */
.hdr-menu-btn {
  display: none;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  width: 42px;
  height: 42px;
  background: rgba(16, 19, 26, 0.8);
  border: 1px solid rgba(245, 180, 0, 0.28);
  border-radius: 10px;
  cursor: pointer;
  padding: 0;
  transition: border-color 0.2s ease, background 0.2s ease;
  flex-shrink: 0;
}
.hdr-menu-btn:hover {
  border-color: rgba(245, 180, 0, 0.55);
  background: rgba(245, 180, 0, 0.12);
}
.hdr-menu-bar {
  display: block;
  width: 20px;
  height: 2px;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 2px;
  transition: transform 0.3s ease, opacity 0.3s ease, width 0.3s ease;
}
/* X state */
.hdr-menu-btn.is-open #bar1 { transform: translateY(7px) rotate(45deg); }
.hdr-menu-btn.is-open #bar2 { opacity: 0; width: 0; }
.hdr-menu-btn.is-open #bar3 { transform: translateY(-7px) rotate(-45deg); }

/* ══════════════════════════════════════════════════
   BACKDROP
   ══════════════════════════════════════════════════ */
.hdr-backdrop {
  position: fixed;
  inset: 0;
  z-index: 110;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.hdr-backdrop.is-visible {
  opacity: 1;
  pointer-events: all;
}

/* ══════════════════════════════════════════════════
   MOBILE / TABLET DRAWER
   ══════════════════════════════════════════════════ */
.hdr-drawer {
  position: fixed;
  top: 0;
  right: 0;
  z-index: 120;
  width: min(340px, 92vw);
  height: 100dvh;
  background: rgba(10, 12, 18, 0.98);
  border-left: 1px solid rgba(245, 180, 0, 0.2);
  backdrop-filter: blur(28px) saturate(1.6);
  -webkit-backdrop-filter: blur(28px) saturate(1.6);
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: -20px 0 60px rgba(0, 0, 0, 0.7);
}
.hdr-drawer.is-open {
  transform: translateX(0);
}

.hdr-drawer-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 1.25rem 1rem;
  border-bottom: 1px solid rgba(245, 180, 0, 0.1);
}
.hdr-drawer-brand {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
  color: var(--gold, #f5b400);
  font-family: var(--display, 'Unbounded', sans-serif);
  font-weight: 700;
  font-size: 0.95rem;
}
.hdr-drawer-close {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  color: rgba(255, 255, 255, 0.7);
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease;
}
.hdr-drawer-close:hover {
  background: rgba(245, 180, 0, 0.15);
  color: #fff;
}

.hdr-drawer-nav {
  flex: 1;
  overflow-y: auto;
  padding: 1rem 0.85rem;
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.hdr-drawer-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.65rem 0.85rem;
  border-radius: 0.75rem;
  font-family: var(--sans, 'Outfit', sans-serif);
  font-size: 0.92rem;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.78);
  text-decoration: none;
  transition: color 0.2s ease, background 0.2s ease, transform 0.18s ease;
  border: 1px solid transparent;
}
.hdr-drawer-link:hover {
  color: #fff;
  background: rgba(245, 180, 0, 0.09);
  transform: translateX(3px);
}
