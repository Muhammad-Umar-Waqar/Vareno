---

<section class="keywords-section" data-reveal>
  <div class="kw-header">
    <h2>Trending searches</h2>
    <p>The GTA 6 questions people and search engines are asking right now</p>
  </div>
  <div class="kw-grid">
    {keywords.map(kw => (
      <a href={kw.href} class={`kw-pill kw-${kw.kd}`} aria-label={`Explore keyword: ${kw.term}`}>
        <span class="kw-term">{kw.term}</span>
        <span class="kw-vol">{kw.volume}</span>
      </a>
    ))}
  </div>
</section>

<style>
.keywords-section {
  padding: 1.5rem 0;
}
.kw-header {
  margin-bottom: 1.25rem;
}
.kw-header h2 {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--paper, #fff);
  margin: 0 0 0.35rem 0;
}
.kw-header p {
  color: var(--muted, rgba(255, 255, 255, 0.55));
  font-size: 0.88rem;
  margin: 0;
}
.kw-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}
.kw-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.38rem 0.85rem;
  border-radius: 999px;
  background: rgba(16, 19, 26, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  text-decoration: none;
  font-family: var(--sans, 'Outfit', sans-serif);
  font-size: 0.82rem;
  transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
}
.kw-pill:hover {
  transform: translateY(-2px);
  background: rgba(245, 180, 0, 0.1);
  border-color: rgba(245, 180, 0, 0.4);
}
.kw-term {
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}
.kw-pill:hover .kw-term {
  color: #fff;
}
.kw-vol {
  font-size: 0.72rem;
  font-weight: 700;
  padding: 0.15rem 0.45rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.06);
}
.kw-easy .kw-vol {
  color: #2ed573;
  background: rgba(46, 213, 115, 0.15);
}
.kw-medium .kw-vol {
  color: #f5b400;
  background: rgba(245, 180, 0, 0.15);
}
.kw-hard .kw-vol {
  color: #ff4757;
  background: rgba(255, 71, 87, 0.15);
}
:global(html[data-theme="light"]) .kw-header h2 {
  color: #090d16;
}

:global(html[data-theme="light"]) .kw-header p {
  color: #475569;
}

:global(html[data-theme="light"]) .kw-pill {
  background: #ffffff;
  border-color: rgba(15, 23, 42, 0.12);
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
}

:global(html[data-theme="light"]) .kw-term {
  color: #090d16;
}

:global(html[data-theme="light"]) .kw-pill:hover {
  background: #ffffff;
  border-color: rgba(200, 110, 0, 0.5);
  box-shadow: 0 4px 14px rgba(200, 110, 0, 0.15);
}

:global(html[data-theme="light"]) .kw-pill:hover .kw-term {
  color: #b45309;
}

:global(html[data-theme="light"]) .kw-vol {
  background: rgba(15, 23, 42, 0.06);
}
</style>
