  { term: 'gta 6 wanted system & heat', kd: 'easy', volume: '>10K', href: '/blog/gta-6-wanted-system-heat-police-stars-explained' },
  { term: 'is there 18+ in gta 6', kd: 'easy', volume: '>10K', href: '/blog/gta-6-romance-mature-rating-nudity-guide' },
