---
const keywords = [
  { term: 'gta 6 release date', kd: 'hard', volume: '>100K', href: '/release-date' },
  { term: 'when does gta 6 come out', kd: 'hard', volume: '>100K', href: '/release-date' },
  { term: 'gta 6 price', kd: 'medium', volume: '>10K', href: '/price' },
  { term: 'how much is gta 6', kd: 'medium', volume: '>10K', href: '/price' },
  { term: 'gta 6 leaks', kd: 'easy', volume: '>10K', href: '/leaks' },
  { term: 'gta 6 new zealand trick', kd: 'easy', volume: '>10K', href: '/tricks/new-zealand-trick' },
  { term: 'gta 6 map', kd: 'hard', volume: '>10K', href: '/map' },
  { term: 'will gta 6 be on pc', kd: 'easy', volume: '>10K', href: '/platforms' },
  { term: 'gta 6 pre order', kd: 'hard', volume: '>10K', href: '/price' },
  { term: 'gta 6 trailer 3', kd: 'easy', volume: '>10K', href: '/trailers' },
  { term: 'gta 6 lucia', kd: 'easy', volume: '>10K', href: '/characters/lucia' },
  { term: 'gta 6 delay', kd: 'easy', volume: '>10K', href: '/release-date' },
  { term: 'rockstar games gta 6', kd: 'easy', volume: '>10K', href: '/release-date' },
  { term: 'gta 6 gameplay', kd: 'easy', volume: '>10K', href: '/trailers' },
  { term: "gta 6 collector's edition", kd: 'medium', volume: '>10K', href: '/price' },
  { term: 'gta 6 august 27 presentation', kd: 'easy', volume: '>10K', href: '/trailers' },
  { term: 'will gta 6 have online', kd: 'easy', volume: '>1K', href: '/platforms' },
  { term: 'is gta 6 out', kd: 'hard', volume: '>10K', href: '/release-date' },
  { term: 'will gta 6 be crossplay', kd: 'easy', volume: '>1K', href: '/platforms' },
  { term: 'how many days till gta 6', kd: 'easy', volume: '>1K', href: '/release-date' },
  { term: 'did gta 6 get delayed again', kd: 'easy', volume: '>1K', href: '/blog/gta-6-delay-history' },
  { term: 'how long has gta 6 been in development', kd: 'easy', volume: '>1K', href: '/blog/how-long-has-gta-6-been-in-development' },
  { term: 'how much is gta 6 pre order', kd: 'medium', volume: '>1K', href: '/price' },
