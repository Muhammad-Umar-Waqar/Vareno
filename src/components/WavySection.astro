---
/**
 * WavySection — wraps any slot content with an animated SVG wave at top.
 * Inspired by Aceternity "wavy-background-demo".
 */
---

<div class="wavy-section">
  <!-- Top wave -->
  <div class="wavy-top" aria-hidden="true">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z" fill="#05060a"/>
      <path class="wave-anim" d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z" fill="rgba(245,180,0,0.07)"/>
    </svg>
  </div>

  <div class="wavy-content">
    <slot />
  </div>

  <!-- Bottom wave (flipped) -->
  <div class="wavy-bottom" aria-hidden="true">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,40 C240,0 480,80 720,40 C960,0 1200,80 1440,40 L1440,0 L0,0 Z" fill="#05060a"/>
    </svg>
  </div>
</div>
