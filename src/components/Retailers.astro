---
/**
 * Aceternity-inspired Retailers & Storefront Showcase
 * Eliminates awkward horizontal stretching with balanced, golden-ratio cards.
 */

const stores = [
  {
    name: 'PlayStation Store',
    platform: 'PS5 & PS5 Pro',
    tag: 'Official Digital Storefront',
    desc: 'Instant digital pre-order with DualSense haptic profile and pre-load unlocked.',
    badge: 'PS5 Standard & Ultimate',
    color: '#0070d1',
    glowColor: 'rgba(0, 112, 209, 0.25)',
    icon: 'ps',
    href: 'https://store.playstation.com/en-us/product/EP1004-PPSA01547_00-GTAVISTANDARD001/',
    btnText: 'Buy on PS Store ↗',
  },
  {
    name: 'Rockstar Games Portal',
    platform: 'Direct Studio Hub',
    tag: 'Official Creator Platform',
    desc: 'Direct Take-Two announcements, official physical box codes, and trailer media.',
    badge: 'Rockstar Verified',
    color: '#f7c948',
    glowColor: 'rgba(247, 201, 72, 0.25)',
    icon: 'star',
    href: 'https://www.rockstargames.com/VI',
    btnText: 'Visit Rockstar VI ↗',
  },
  {
    name: 'Microsoft Xbox Store',
    platform: 'Xbox Series X|S',
    tag: 'Official Xbox Marketplace',
    desc: 'Digital orders for Series X and Series S with cloud sync and quick resume.',
    badge: 'Series X|S Optimized',
    color: '#107c10',
    glowColor: 'rgba(16, 124, 16, 0.25)',
    icon: 'xbox',
    href: 'https://www.microsoft.com/en-us/search/shop?q=Grand%20Theft%20Auto%20VI',
    btnText: 'Buy on Xbox Store ↗',
  },
];
---

<section class="retailers-section" data-reveal aria-labelledby="retailers-heading">
  <!-- Ambient background glow -->
  <div class="retailers-glow" aria-hidden="true"></div>

  <div class="retailers-container">
    <div class="retailers-header">
      <span class="retailers-badge">
        <span class="retailers-badge-dot"></span>
        Authorized Retailers
      </span>
      <h2 id="retailers-heading" class="retailers-title">Where To Buy GTA 6</h2>
      <p class="retailers-subtitle">
        Take-Two announced three official storefront channels. Regional currencies and local store midnight unlocks apply.
      </p>
    </div>

    <div class="retailers-grid">
      {stores.map((store) => (
        <div class="retailer-card" style={`--store-color: ${store.color}; --store-glow: ${store.glowColor};`}>
          <div class="rc-border-glow" aria-hidden="true"></div>

          <div class="rc-content">
            <div class="rc-top">
              <div class="rc-icon-wrap">
                {store.icon === 'ps' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
                  </svg>
                )}
                {store.icon === 'star' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                )}
                {store.icon === 'xbox' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2a10 10 0 100 20 10 10 0 000-20zm3.8 14.2c-.8.6-1.8 1-2.9 1.1-.3 0-.6.1-.9.1s-.6 0-.9-.1c-1.1-.1-2.1-.5-2.9-1.1-1-1-1.6-2.2-1.9-3.5-.2-.9-.2-1.8 0-2.7.3-1.3.9-2.5 1.9-3.5 1.1-1.1 2.5-1.8 4-2 1.6-.2 3.1.2 4.4 1.1-1.5 1-2.8 2.2-3.8 3.7-.7 1-1.2 2.1-1.5 3.3.4.1.8.3 1.2.6.4-.9.9-1.7 1.5-2.4 1.1-1.4 2.5-2.4 4.1-3.2.1.8.1 1.7 0 2.5-.3 1.3-1 2.5-2 3.5-.4.5-.8.9-1.3 1.2.3.4.7.7 1.1 1 .5-.3.9-.7 1.3-1.1.8-1 1.3-2.1 1.5-3.3.5 1.2.6 2.5.4 3.8-.3 1.5-1 2.8-2 3.9z"/>
                  </svg>
                )}
              </div>
              <span class="rc-badge">{store.badge}</span>
            </div>

            <h3 class="rc-name">{store.name}</h3>
            <span class="rc-platform">{store.platform}</span>
            <p class="rc-desc">{store.desc}</p>

            <a class="rc-btn" href={store.href} target="_blank" rel="sponsored noopener noreferrer">
              <span>{store.btnText}</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.retailers-section {
  position: relative;
  margin: 3.5rem 0;
  padding: 3.5rem 2rem;
  border-radius: 1.75rem;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(14, 11, 24, 0.5);
  backdrop-filter: blur(16px);
  overflow: hidden;
}

.retailers-glow {
  position: absolute;
  top: 30%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 500px;
  height: 300px;
  background: radial-gradient(circle, rgba(247, 201, 72, 0.08) 0%, rgba(0, 112, 209, 0.06) 60%, transparent 80%);
  filter: blur(50px);
  pointer-events: none;
}

.retailers-container {
  position: relative;
  z-index: 1;
  max-width: 1050px;
  margin: 0 auto;
}

.retailers-header {
  text-align: center;
  margin-bottom: 2.75rem;
}

.retailers-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #f7c948;
  background: rgba(247, 201, 72, 0.12);
  padding: 0.35rem 0.85rem;
  border-radius: 50px;
  margin-bottom: 0.85rem;
}

.retailers-badge-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #f7c948;
  box-shadow: 0 0 8px #f7c948;
}

.retailers-title {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: clamp(1.6rem, 3vw, 2.3rem);
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.03em;
  margin: 0 0 0.75rem;
}

.retailers-subtitle {
  color: rgba(255, 255, 255, 0.65);
  font-size: 0.95rem;
  line-height: 1.6;
  max-width: 620px;
  margin: 0 auto;
}

/* 3-Card Grid with Max-Width Constraint */
.retailers-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  gap: 1.5rem;
  width: 100%;
  box-sizing: border-box;
}

.retailer-card {
  position: relative;
  background: #0f0c1c;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 1.25rem;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  overflow: hidden;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.retailer-card:hover {
  transform: translateY(-4px);
  border-color: var(--store-color, #f7c948);
  box-shadow: 0 16px 40px var(--store-glow, rgba(0,0,0,0.5));
}

.rc-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.25rem;
}

.rc-icon-wrap {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--store-color, #fff);
  display: flex;
  align-items: center;
  justify-content: center;
}

.rc-badge {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.65rem;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.65);
  background: rgba(255, 255, 255, 0.05);
  padding: 0.25rem 0.65rem;
  border-radius: 50px;
  text-transform: uppercase;
}

.rc-name {
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 1.15rem;
  font-weight: 700;
  color: #fff;
  margin: 0 0 0.35rem;
  letter-spacing: -0.02em;
}

.rc-platform {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--store-color, #f7c948);
  font-family: var(--display, 'Unbounded', sans-serif);
  margin-bottom: 0.75rem;
  display: block;
}

.rc-desc {
  font-size: 0.88rem;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.6;
  margin: 0 0 1.75rem;
  flex: 1;
}

.rc-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #fff;
  font-family: var(--display, 'Unbounded', sans-serif);
  font-size: 0.82rem;
  font-weight: 700;
  padding: 0.85rem 1.25rem;
  border-radius: 50px;
  text-decoration: none;
  transition: all 0.25s ease;
  margin-top: auto;
}

.rc-btn:hover {
  background: var(--store-color, #f7c948);
  color: #05040a;
  border-color: var(--store-color, #f7c948);
  box-shadow: 0 6px 20px var(--store-glow, rgba(0,0,0,0.3));
}

:global(html[data-theme="light"]) .retailers-section {
  background: #ffffff;
  border: 1px solid rgba(15, 23, 42, 0.1);
  box-shadow: 0 10px 40px rgba(15, 23, 42, 0.05);
}

:global(html[data-theme="light"]) .retailers-glow {
  background: radial-gradient(circle, rgba(200, 110, 0, 0.05) 0%, rgba(2, 132, 199, 0.03) 60%, transparent 80%);
}

:global(html[data-theme="light"]) .retailers-badge {
  background: #fef3c7;
  color: #92400e;
}

:global(html[data-theme="light"]) .retailers-badge-dot {
  background: #d97706;
  box-shadow: 0 0 8px rgba(217, 119, 6, 0.4);
}

:global(html[data-theme="light"]) .retailers-title {
  color: #090d16;
}

:global(html[data-theme="light"]) .retailers-subtitle {
  color: #475569;
}

:global(html[data-theme="light"]) .retailer-card {
  background: #f8fafc;
  border: 1px solid rgba(15, 23, 42, 0.09);
  box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
}

:global(html[data-theme="light"]) .retailer-card:hover {
  background: #ffffff;
  border-color: var(--store-color, #c86e00);
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
}

:global(html[data-theme="light"]) .rc-name {
  color: #090d16;
}

:global(html[data-theme="light"]) .rc-platform {
  color: #64748b;
}

:global(html[data-theme="light"]) .rc-desc {
  color: #334155;
}

:global(html[data-theme="light"]) .rc-icon-wrap {
  background: rgba(15, 23, 42, 0.05);
  border-color: rgba(15, 23, 42, 0.12);
}

:global(html[data-theme="light"]) .rc-badge {
  background: rgba(15, 23, 42, 0.06);
  color: #475569;
}

:global(html[data-theme="light"]) .rc-btn {
  background: #0f172a;
  border-color: #0f172a;
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
}

:global(html[data-theme="light"]) .rc-btn:hover {
  background: var(--store-color, #c86e00);
  border-color: var(--store-color, #c86e00);
  color: #ffffff;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
}

:global(html[data-theme="light"]) .rc-footer {
  border-top-color: rgba(15, 23, 42, 0.08);
}

@media (max-width: 768px) {
  .retailers-section {
    padding: 2rem 1.15rem;
    margin: 2.5rem 0;
    border-radius: 1.25rem;
  }
  .retailers-header {
    margin-bottom: 2rem;
  }
  .retailers-title {
    font-size: 1.55rem;
  }
  .retailers-subtitle {
    font-size: 0.88rem;
  }
  .retailers-grid {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .retailer-card {
    padding: 1.5rem 1.25rem;
    border-radius: 1rem;
  }
  .rc-name {
    font-size: 1.1rem;
  }
  .rc-desc {
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .rc-btn {
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
  }
}
</style>
